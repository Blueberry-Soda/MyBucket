    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\$fname\" -ArgumentList @($env:TEMP) -Wait",
            "Move-Item -Path \"$env:TEMP\\Calibre Portable\\*\" -Destination $dir -Force",
            "Remove-Item -Path \"$dir\\$fname\", \"$env:TEMP\\Calibre Portable\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Icacls $dir /t /c /reset | Out-Null"
        ]
    },
    "shortcuts": [
        [
            "calibre-portable.exe",
            "Calibre"
        ]
    ],
    "persist": [
        "Calibre Library",
        "Calibre Settings"
    ],
